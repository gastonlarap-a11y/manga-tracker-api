{
  "name": "manga-tracker-api",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "package": "bun run scripts/package.ts",
    "bench:library": "bun run scripts/bench-library.ts",
    "sync:inspect": "bun run scripts/inspect-replica.ts",
    "sync:bootstrap": "bun run scripts/bootstrap-credentials.ts",
    "deploy": "bun run deploy/deploy.ts",
    "deploy:provision": "bun run deploy/provision.ts",
    "env:push": "bun run deploy/env-push.ts",
    "env:pull": "bun run deploy/env-pull.ts",
    "env:show": "bun run deploy/env-show.ts",
    "setup:windows": "bun run deploy/bootstrap-windows.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "hono": "^4.13.12",
    "mongodb": "^6.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
