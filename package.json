    "@prisma/client": "^7.8.0",
    "hono": "^4.12.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "latest",
    "prisma": "^7.8.0",
    "typescript": "^7.0.2"
  }
}
