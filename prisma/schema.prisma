// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // Connection URL lives in prisma.config.ts (Prisma 7); the runtime
  // connects through @prisma/adapter-libsql in src/db/client.ts.
}

// ------------------------------------------------------
// Core Domain: Manga Identity
// ------------------------------------------------------
model Manga {
  id             String   @id @default(uuid())
  canonicalName  String
  // Unique identifier mapped via normalizeSlug() to prevent duplicates
  normalizedSlug String   @unique
  // Cover image reported by the extension (og:image of a chapter page)
  coverUrl       String?
  // Cover bytes captured by the extension in the real browser — the only
  // client Cloudflare-walled CDNs admit. Served before proxying coverUrl.
  coverImage     Bytes?
  coverImageType String?
  // Bumped on every cover mutation; the dashboard cache-busts /cover with it.
  coverVersion   Int      @default(0)
  // Manual reading status: "reading" | "completed" | "dropped"
  status         String   @default("reading")
  // Manual tags as a JSON array of strings (SQLite has no array columns)
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  // Last-write-wins tiebreaker when two machines edited the same manga.
  // Deliberately NOT @updatedAt: that attribute overwrites the value on every
  // write, so applying a peer's document would stamp it as "just modified" and
  // the two machines would push it back and forth forever. Every writer sets
  // it explicitly instead.
  updatedAt      DateTime @default(now())
  // Soft delete, so a deletion is a fact that syncs like any other field
  // rather than something inferred from a row being absent — absence is
  // ambiguous across machines and used to mean "delete this from the replica".
  deletedAt      DateTime?
  // normalizedSlug of the canonical manga that absorbed this one. A non-null
  // value turns this row into an ALIAS: it stops projecting as its own card and
  // its events are read as part of the canonical's group. Merging this way moves
  // no ReadingEvent, so the append-only rule survives untouched.
  // By slug and not by id because sync is keyed on natural keys (sync.mapper.ts):
  // two machines mint different uuids for the same manga but agree on the slug.
  // Converges last-write-wins on updatedAt, like every other field here.
  mergedIntoSlug String?

  events ReadingEvent[]

  @@index([mergedIntoSlug])
}

// ------------------------------------------------------
// Duplicate Detection: rejected suggestions
// ------------------------------------------------------
/// "These two are NOT the same manga" — silences a pair in /duplicates until
/// the user takes it back. The mandatory counterpart of lowering the detection
/// threshold: without it a false positive comes back on every load of the view
/// and the report is noise.
model DuplicateDismissal {
  id String @id @default(uuid())

  // The two normalizedSlugs, always stored in lexicographic order, so the pair
  // (a,b) and the pair (b,a) are the same row on every machine.
  slugA String
  slugB String

  createdAt DateTime @default(now())
  // Same reasoning as Manga.updatedAt: set explicitly, never by @updatedAt. It
  // decides which machine's word on the pair wins (last write wins).
  updatedAt DateTime @default(now())
  // A dismissal taken back ("volver a sugerir"). A value rather than a deleted
  // row for the reason Manga.deletedAt is one: sync never removes anything for
  // being absent on one side, so a deleted row would be pulled right back.
  revokedAt DateTime?

  @@unique([slugA, slugB])
}

// ------------------------------------------------------
// Event Sourcing: Reading History (Append-Only)
// ------------------------------------------------------
model ReadingEvent {
  id      String @id @default(uuid())
  mangaId String

  // Original text scraped from the DOM (e.g., "Cap. 130.5")
  chapterLabel  String
  // Parsed numeric value for sorting. Null if heuristic fails to parse a number.
  chapterNumber Float?

  sourceUrl    String
  sourceDomain String
  readAt       DateTime @default(now())

  // "<host><path>" of the SERIES page this chapter belongs to, derived by the
  // server from the seriesUrl the extension reports. It is the strongest
  // identity a single site can offer: the series path does not change when the
  // site reformats its <title>, so the same series never splits into two
  // mangas on one domain. Null when the page exposed no series link.
  seriesKey String?

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  // Critical index for the Library view: "Get the latest readAt for a specific mangaId"
  @@index([mangaId, readAt(sort: Desc)])
  // Drives the "which manga is this series?" lookup on every ingestion.
  @@index([seriesKey])
  // The activity panel reads one window of days, never the whole log.
  @@index([readAt])
}

// ------------------------------------------------------
// Read model: the library projection
// ------------------------------------------------------
// Everything below is derived from Manga and ReadingEvent and never synced:
// each machine builds its own from the rows it has. It exists so that reading
// the library costs what is shown, not what was ever read — the projection used
// to be recomputed per request from every manga, every event and every stored
// cover's bytes.
//
// Kept current by triggers (see the migration that creates these tables), not
// by the code paths that write: ingestion, edits, merges, deletes and sync all
// write Manga and ReadingEvent, and a trigger cannot be forgotten by a new one.

/// One row per card: an alive canonical manga with the aggregates of its whole
/// group (its own events plus those of every alias merged into it).
model LibraryEntry {
  /// The canonical manga that owns the card.
  mangaId          String   @id
  canonicalName    String
  normalizedSlug   String
  /// canonicalName lowercased and stripped of accents, for search.
  searchKey        String
  /// What A–Z orders by: the search key, so "Ásura" sorts beside "Asura".
  sortKey          String
  coverUrl         String?
  coverVersion     Int
  hasStoredCover   Boolean
  status           String
  tags             String
  reachedNumber    Float?
  reachedLabel     String?
  /// The newest event of the group; the epoch for a card with none yet (its
  /// events have not synced in), so ordering never has to handle a null.
  lastReadAt       DateTime
  lastChapterLabel String?
  lastSourceUrl    String?
  /// Distinct chapters, not rows — the same rule as ever.
  readCount        Int
  /// JSON array, most recently read first: the cover proxy tries their
  /// referers in this order.
  sourceDomains    String
  aliasCount       Int

  domains LibraryEntryDomain[]

  @@index([lastReadAt(sort: Desc), mangaId])
  @@index([status, lastReadAt(sort: Desc), mangaId])
  @@index([sortKey, mangaId])
  @@index([readCount(sort: Desc), mangaId])
}

/// The sites a card was read on, one row each, so filtering by site and
/// counting sites are index lookups rather than scans of a JSON column.
model LibraryEntryDomain {
  mangaId String
  domain  String

  entry LibraryEntry @relation(fields: [mangaId], references: [mangaId], onDelete: Cascade)

  @@id([mangaId, domain])
  @@index([domain])
}

/// Which card every manga row belongs to, deleted ones included: the history,
/// cover and edit endpoints resolve any id — an alias's too — with one lookup.
model LibraryMember {
  memberId    String @id
  canonicalId String

  @@index([canonicalId])
}

/// Manga rows whose card has to be recomputed, marked by the triggers. `seq`
/// lets a refresh clear exactly what it processed and keep anything marked
/// while it ran.
model LibraryDirty {
  mangaId String @id
  seq     Int

  // Every trigger reads MAX(seq): indexed, that is a lookup however many
  // marks a large sync pull leaves behind, not a scan per inserted event.
  @@index([seq])
}

/// A counter the triggers bump whenever what /duplicates could answer changes:
/// a title, a cover, a merge, a deletion or a dismissal. Readings do not.
model LibraryRevision {
  id     Int @id
  titles Int
}

// ------------------------------------------------------
// Configuration Domain: Scraping Adapters
// ------------------------------------------------------
model SiteAdapter {
  id     String @id @default(uuid())
  // The hostname (e.g., "olympusxyz.com")
  domain String @unique

  // CSS Selectors generated by @medv/finder during the calibration phase
  titleSelector   String
  chapterSelector String?
  chapterUrlRegex String?

  createdAt DateTime @default(now())
  // Same reasoning as Manga.updatedAt: set explicitly, never by @updatedAt, so
  // a document pulled from a peer keeps the timestamp that decides who wins.
  updatedAt DateTime @default(now())
}

/// When the extension counts a chapter page as read, set from the dashboard.
/// One row (id 1), absent until someone changes a value — the defaults below
/// are what an absent row means. Local to this machine and never synced: how
/// long someone reads on this computer is not a fact about their library.
model ExtensionSettings {
  id                   Int      @id
  // Off by default: a chapter counts the moment its page is recognised, which
  // is how every release before this one behaved.
  readingRequired      Boolean  @default(false)
  // Seconds the page has to stay visible, and how far down it has to be
  // scrolled. Either at 0 drops that condition.
  readMinSeconds       Int      @default(30)
  readMinScrollPercent Int      @default(80)
  updatedAt            DateTime @default(now())
}
