{
  "enabledPlugins": {
    "api-design@dev-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(bun install:*)",
      "Bash(bun test:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run format:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run db:generate:*)"
    ],
    "ask": ["Bash(bun run db:migrate:*)", "Bash(git push:*)"],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./src/generated/**)",
      "Read(./**/*.db)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.ts)",
            "command": "jq -r '.tool_input.file_path' | xargs -r bunx biome check --write"
          },
          {
            "type": "command",
            "if": "Write(*.ts)",
            "command": "jq -r '.tool_input.file_path' | xargs -r bunx biome check --write"
          },
          {
            "type": "command",
            "if": "Edit(*.json)",
            "command": "jq -r '.tool_input.file_path' | xargs -r bunx biome check --write"
          },
          {
            "type": "command",
            "if": "Write(*.json)",
            "command": "jq -r '.tool_input.file_path' | xargs -r bunx biome check --write"
          }
        ]
      }
    ]
  }
}
